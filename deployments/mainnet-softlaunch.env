# Mainnet soft launch: tiny positions, low leverage, one LP (the operator).
#
#   set -a; source deployments/mainnet-softlaunch.env; set +a
#   NETWORK_KEY=mainnet make deploy-mainnet
#
# Fill every empty value first. See docs/plan/mainnet-softlaunch.md.

# --- Network ---------------------------------------------------------------
# A mainnet Soroban RPC provider; the script's default URL is not a public RPC.
RPC_URL=
# Circle USDC on Stellar (7 decimals). Verify against Circle's docs before use.
ASSET_ADDR=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75

# --- Role holders: distinct accounts, none of them the admin -----------------
UPGRADER_ADDR=
PAUSER_ADDR=
UNPAUSER_ADDR=
ORACLE_ADDR=
PROTOCOL_ADDR=
# Price publishers (default: the `binance-oracle` / `kucoin-oracle` identities).
# BINANCE_PUBLISHER_ADDR=
# KUCOIN_PUBLISHER_ADDR=

# --- Positions -------------------------------------------------------------
# $1 minimum collateral after the keeper reward; a trader submits about $1.05.
MIN_COLLATERAL=10000000
# 3x maximum leverage; liquidation at 15% maintenance margin.
INITIAL_MARGIN_BPS=3334
MAINTENANCE_MARGIN_BPS=1500
# $25 of open interest per side per market: at most ~25 one-dollar positions.
MAX_MARKET_SIZE_OPEN_INTEREST=250000000
MAX_ACTIVE_MARKETS=3

# --- Keeper ----------------------------------------------------------------
# $0.02 per settlement, liquidation and LP resolution. Must stay below
# MIN_COLLATERAL; must cover the keeper's XLM fee per transaction.
KEEPER_REWARD=200000

# --- Governance ------------------------------------------------------------
# One day (the floor) to raise a limit. Lowering caps and raising margin is
# immediate through the governor's conservative fast path.
CONFIG_TIMELOCK_SECONDS=86400
FEED_TIMELOCK_SECONDS=86400

# --- Price feed --------------------------------------------------------------
FEED_MIN_SOURCES=2
FEED_MAX_SOURCE_AGE_SECONDS=30
FEED_MAX_DEVIATION_BPS=50
MAX_PRICE_AGE_SECONDS=60

# --- LP --------------------------------------------------------------------
# The operator is the only LP; one hour lets them exit quickly if needed.
LP_REQUEST_DELAY=3600
